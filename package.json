{
  "name": "historical-source-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "check-types": "tsc --noEmit",
    "db:down": "bun run services:down",
    "db:migrate": "docker compose exec -T postgres psql -U atlas -d historical_source_atlas < db/migrations/001_initial_schema.sql && docker compose exec -T postgres psql -U atlas -d historical_source_atlas < db/migrations/002_referenced_entities.sql",
    "db:schema": "docker compose exec -T postgres psql -U atlas -d historical_source_atlas < db/migrations/001_initial_schema.sql",
    "db:seed": "docker compose exec -T postgres psql -U atlas -d historical_source_atlas < db/seeds/001_current_static_sources.sql",
    "db:up": "bun run services:up",
    "dev": "vite --host 0.0.0.0",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "preview": "vite preview --host 0.0.0.0",
    "services:up": "docker compose up -d postgres minio minio-create-buckets",
    "services:down": "docker compose stop postgres minio",
    "services:clean": "docker compose down -v --remove-orphans",
    "services:ps": "docker compose ps",
    "build-storybook": "storybook build",
    "storybook": "storybook dev -p 6006 --host 0.0.0.0",
    "test": "bun run test:unit && bun run test:db && bun run test:e2e",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "verify": "bun run check-types && bun run format:check && bun run test:unit && bun run build && bun run build-storybook"
  },
  "dependencies": {
    "@moritzbrantner/data-density": "link:../maps/node_modules/@moritzbrantner/data-density",
    "@moritzbrantner/maps": "link:../maps",
    "@moritzbrantner/timeline-editor": "link:../maps/node_modules/@moritzbrantner/timeline-editor",
    "@moritzbrantner/ui": "https://registry.npmjs.org/@moritzbrantner/ui/-/ui-0.8.0.tgz",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.14",
    "leaflet": "^1.9.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.52.0",
    "pg": "^8.21.0",
    "storybook": "^10.4.1",
    "typescript": "6.0.2",
    "vite": "^8.0.13",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "@moritzbrantner/data-density": "link:../maps/node_modules/@moritzbrantner/data-density",
    "@moritzbrantner/timeline-editor": "link:../maps/node_modules/@moritzbrantner/timeline-editor"
  },
  "packageManager": "bun@1.3.12"
}
