# Postgres connection string
DATABASE_URL="postgresql://atlas:atlas_password@localhost:55434/historical_source_atlas"

# Local Postgres container
POSTGRES_DB="historical_source_atlas"
POSTGRES_USER="atlas"
POSTGRES_PASSWORD="atlas_password"
POSTGRES_PORT="55434"

# Historical source object storage
SOURCE_STORAGE_REGION="us-east-1"
SOURCE_STORAGE_ENDPOINT="http://127.0.0.1:9000"
SOURCE_STORAGE_ACCESS_KEY_ID="minioadmin"
SOURCE_STORAGE_SECRET_ACCESS_KEY="minioadmin"
SOURCE_STORAGE_FORCE_PATH_STYLE="true"

# Local MinIO object storage
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"
MINIO_ORIGINALS_BUCKET="source-originals"
MINIO_PUBLIC_BUCKET="source-public"
MINIO_DERIVATIVES_BUCKET="source-derivatives"
MINIO_API_PORT="9000"
MINIO_CONSOLE_PORT="9001"
